[Unit]
Description=Libitu Stage 2 fast lane (legacy unit name)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/libitu/apps/api
EnvironmentFile=/etc/libitu/api.env
Environment=ACOUSTIC_SCHEDULER_PATH=/var/lib/libitu/acoustic-scheduler
ExecStart=/opt/libitu/apps/api/.venv/bin/python -m app.workers.stage_two_worker --lane fast
Restart=on-failure
RestartSec=5
User=libitu
StateDirectory=libitu
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
