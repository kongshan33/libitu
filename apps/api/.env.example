# Clerk backend token verification
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Supabase server configuration. Never expose the secret key to browser code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Supabase Auth metadata only; Clerk remains Libitu's identity provider.
SUPABASE_JWKS_URL=

# Upstash Redis REST credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Asynchronous blueprint processing
PROCESSING_MODE=inline
ANALYSIS_VERSION=mvp-v9
PROCESSING_QUEUE_NAME=libitu:queue:blueprints
PROCESSING_STATE_TTL_SECONDS=86400
PROCESSING_LOCK_TTL_SECONDS=900
PROCESSING_WORKER_CONCURRENCY=2
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_TTL_SECONDS=20
UPSTASH_TIMEOUT_SECONDS=10
UPSTASH_MAX_RETRIES=1
UPSTASH_RETRY_INTERVAL_SECONDS=0.5

# Doubao structured text analysis. Server-only.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-1-lite-260915
ARK_TIMEOUT_SECONDS=90
ARK_MAX_ATTEMPTS=2
ARK_MAX_INPUT_CHARS=240000
ARK_MAX_OUTPUT_TOKENS=32000

# Stage 4 live role-play. Credentials remain on the API server.
SPEAKING_REALTIME_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Kore
# Optional alternative adapter; select openai above to use it.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
SPEAKING_MAX_CONNECTION_SECONDS=1200
SPEAKING_MAX_TURNS=100
SPEAKING_IDLE_SECONDS=180
SPEAKING_LEASE_SECONDS=60
SPEAKING_MAX_OUTPUT_TOKENS=450

# Local English subtitle punctuation. Empty paths use apps/api/.models defaults.
PUNCTUATION_MODEL_PATH=
PUNCTUATION_BPE_VOCAB_PATH=
PUNCTUATION_NUM_THREADS=1
PUNCTUATION_WINDOW_WORDS=120
PUNCTUATION_OVERLAP_WORDS=20
TRANSCRIPT_PREVIEW_LIMIT=1000

# Optional private file references. Grants are maintained by an operator, never by clients.
ACOUSTIC_SOURCES_PATH=
# Provision with: uv run --extra acoustics python -m scripts.download_practice_asr --output /absolute/model/directory
PRACTICE_ASR_MODEL_PATH=
PRACTICE_ASR_MODEL_SHA256=
ACOUSTIC_MFA_BINARY=mfa
ACOUSTIC_MFA_DICTIONARY=
ACOUSTIC_MFA_MODEL=
ACOUSTIC_MFA_DICTIONARY_SHA256=
ACOUSTIC_MFA_MODEL_SHA256=
# Empty uses the repository's existing pinned web Silero V5 asset.
ACOUSTIC_SILERO_PATH=
ACOUSTIC_LEASE_SECONDS=120
ACOUSTIC_POLL_SECONDS=0.5
# Shared by API and workers on the same host; private, bounded 30-minute audio handoff.
ACOUSTIC_AUDIO_CACHE_PATH=.cache/analysis-audio
# Reusable compiled dictionaries only; sentence audio/results stay in per-job directories.
ACOUSTIC_MFA_CACHE_PATH=.cache/mfa-runtime

# Stage 2 independent local worker lanes. Both must share this private directory.
ACOUSTIC_SCHEDULER_PATH=.cache/acoustic-scheduler
ACOUSTIC_FINE_NICE=10
# Optional Linux hard affinity: configure BOTH as disjoint allowed CPU IDs.
# Leave empty on macOS; MFA yields cooperatively to active fast jobs.
ACOUSTIC_FAST_CPUS=
ACOUSTIC_FINE_CPUS=
